# Copy this file to .env and replace the placeholders with the connection string
# shown in your Neon project. Prefer the pooled connection string for the app.
# Keep sslmode=require in the URL and never commit your real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

PORT=3000

# Set to true to apply pending TypeORM migrations when the app starts.
# Keep false for production; run migrations as a separate deployment step.
RUN_MIGRATIONS=false
