# Copy this file to .env and replace the placeholders with the connection string
# shown in your Neon project. Prefer the pooled connection string for the app.
# Keep sslmode=require in the URL and never commit your real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

PORT=3000

# Exact frontend origin(s), comma-separated if needed; do not include URL paths.
CORS_ORIGIN=http://localhost:5173

# Generate a unique secret (at least 32 random bytes) and keep it private.
JWT_SECRET=CHANGE_ME

# Used only by `npm run seed:admin` to create the initial administrator.
ADMIN_REGISTRATION_NO=1234567
ADMIN_PASSWORD=ChangeMe123
ADMIN_FULL_NAME=System Administrator

# Set to true to apply pending TypeORM migrations when the app starts.
# Keep false for production; run migrations as a separate deployment step.
RUN_MIGRATIONS=false

# Institution timezone (IANA name) used to decide which class dates are in the past.
APP_TIMEZONE=America/La_Paz
